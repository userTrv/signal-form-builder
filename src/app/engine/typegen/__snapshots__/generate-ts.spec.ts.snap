exports[`type generation (text) > matches the snapshot for insurance 1`] = `
"/**
 * Car insurance quote
 * Generated from schema "insuranceQuote" — model value while editing.
 */
export interface InsuranceQuoteDraft {
  /** Driver */
  driver: {
    /**
     * Date of birth
     * ISO date, \`YYYY-MM-DD\`
     */
    birthDate: string;
    /** Years with a licence */
    licenseYears: number | null;
  };
  /** Vehicle */
  vehicle: {
    /** Make */
    make: 'vw' | 'toyota' | 'bmw' | 'tesla' | 'other' | '';
    /** Year of manufacture */
    year: number | null;
    /** Current value */
    value: number | null;
  };
  /** Coverage */
  coverage: 'liability' | 'partial' | 'full' | '';
  /**
   * Deductible
   * @visibleWhen \`coverage == 'partial' || coverage == 'full'\`
   */
  deductible: '0' | '500' | '1000' | '';
  /** Extras (€45 each) */
  extras: Array<'roadside' | 'rental' | 'glass'>;
  /**
   * Policy start
   * ISO date, \`YYYY-MM-DD\`
   */
  startDate: string;
  /**
   * Driver age
   * @computed \`age(driver.birthDate)\`
   */
  driverAge: number | null;
  /**
   * Risk factor
   * @computed \`driverAge == null ? null : driverAge < 25 ? 1.6 : driver.licenseYears < 3 ? 1.3 : 1\`
   */
  riskFactor: number | null;
  /**
   * Yearly premium
   * value × rate(coverage) × risk − deductible discount + extras
   * @computed \`round(vehicle.value * (coverage == 'full' ? 0.045 : coverage == 'partial' ? 0.03 : 0.018) * riskFactor - (deductible == '1000' ? 120 : deductible == '500' ? 60 : 0) + len(extras) * 45, 2)\`
   */
  premium: number | null;
}
"
`;

