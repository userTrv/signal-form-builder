exports[`type generation (text) > matches the snapshot for signup 1`] = `
"/**
 * Create an account
 * Generated from schema "signup" — model value while editing.
 */
export interface SignupDraft {
  /**
   * Username
   * Try "admin" or "angular" — they are taken (checked asynchronously).
   */
  username: string;
  /** Email */
  email: string;
  /** Password */
  password: string;
  /** Confirm password */
  confirmPassword: string;
  /** Plan */
  plan: 'free' | 'pro' | 'team' | '';
  /**
   * Seats
   * Only for the Team plan.
   * @visibleWhen \`plan == 'team'\`
   */
  seats: number | null;
  /** Send me product updates */
  newsletter: boolean;
  /** I accept the terms of service */
  terms: boolean;
}
"
`;

