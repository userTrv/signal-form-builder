exports[`type generation (text) > matches the snapshot for event 1`] = `
"/**
 * Conference registration
 * Generated from schema "eventRegistration" — model value while editing.
 */
export interface EventRegistrationDraft {
  /** Event */
  event: 'ng-berlin' | 'signals-camp' | 'frontend-warsaw' | '';
  /** Days attending */
  days: { start: string; end: string };
  /** Attendees */
  attendees: Array<{
    /** Name */
    name: string;
    /** Email */
    email: string;
    /** Ticket */
    ticket: 'standard' | 'vip' | 'student' | '';
    /**
     * Price
     * @computed \`ticket == 'vip' ? 449 : ticket == 'student' ? 99 : ticket == 'standard' ? 199 : null\`
     */
    price: number | null;
    /**
     * Student ID
     * @visibleWhen \`ticket == 'student'\`
     */
    studentId: string;
  }>;
  /**
   * Promo code
   * Try NGCONF or SIGNALS — checked against the mock server.
   */
  promo: string;
  /**
   * Attendees
   * @computed \`len(attendees)\`
   */
  attendeeCount: number | null;
  /**
   * Total
   * @computed \`sum(attendees.price)\`
   */
  total: number | null;
  /** I need an invoice for a company */
  invoice: boolean;
  /**
   * Company details
   * @visibleWhen \`invoice\`
   */
  company: {
    /** Company name */
    name: string;
    /** VAT ID */
    vatId: string;
  };
}
"
`;

