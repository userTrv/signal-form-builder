exports[`type generation (text) > matches the snapshot for job 1`] = `
"/**
 * Job application
 * Generated from schema "jobApplication" — model value while editing.
 */
export interface JobApplicationDraft {
  /** Full name */
  fullName: string;
  /** Email */
  email: string;
  /** Phone */
  phone: string;
  /** Portfolio or GitHub URL */
  profileUrl: string;
  /** Country */
  country: string;
  /**
   * City
   * Loaded for the selected country.
   */
  city: string;
  /** Role you apply for */
  role: 'frontend' | 'fullstack' | 'lead' | 'other' | '';
  /**
   * Which role?
   * @visibleWhen \`role == 'other'\`
   */
  otherRole: string;
  /** Years of experience */
  years: number | null;
  /**
   * Skills
   * Pick at least two.
   */
  skills: Array<'angular' | 'rxjs' | 'signals' | 'ngxs' | 'typescript' | 'testing'>;
  /** Previous positions */
  positions: Array<{
    /** Company */
    company: string;
    /** Title */
    title: string;
    /** Period */
    period: { start: string; end: string };
  }>;
  /**
   * Available from
   * ISO date, \`YYYY-MM-DD\`
   */
  availableFrom: string;
  /** Expected salary (yearly) */
  salary: number | null;
  /** Work mode */
  workMode: 'remote' | 'hybrid' | 'office' | '';
  /**
   * Open to relocation
   * @visibleWhen \`workMode != 'remote'\`
   */
  relocate: boolean;
  /**
   * Preferred city
   * @visibleWhen \`relocate && workMode != 'remote'\`
   */
  relocationCity: string;
  /**
   * CV (PDF)
   * Stays in your browser — only name and size are kept.
   */
  cv: FileMeta[];
  /** Cover letter */
  coverLetter: string;
  /** How was this form? */
  formRating: number | null;
  /** I agree to the processing of my data for this application */
  consent: boolean;
}

export interface FileMeta {
  name: string;
  size: number;
  type: string;
}
"
`;

